ibrary(magick)
library(magick)
install.packages("magick")
library(magick)
# Load your figure file
file_path <- "~/Documents/plusone/Fig1.tiff"
img <- image_read(file_path)
# Get image metadata
info <- image_info(img)
# Print the essential details
cat("--- Figure Details ---\n")
cat("Format:", info$format, "\n")
cat("Width:", info$width, "pixels\n")
cat("Height:", info$height, "pixels\n")
# Extract details including density/DPI
cat("Resolution (DPI):", info$density, "\n")
# Quick verification note
if (grepl("x", info$density)) {
dpi_val <- as.numeric(strsplit(info$density, "x")[[1]][1])
if (!is.na(dpi_val) && dpi_val >= 300) {
cat(" Check: Resolution meets PLOS ONE standards!\n")
} else {
cat(" Warning: Resolution might be too low (< 300 DPI).\n")
}
}
