memory_target_product, memory_key,
memory_option_1, memory_option_2, memory_option_3
)
cat("\n── Final clean dataset ─────────────────────────────────────\n")
cat("Trials:       ", nrow(ratings_long), "\n")
cat("Participants: ", n_distinct(ratings_long$participant), "\n")
cat("Per condition:\n")
print(table(ratings_long$version))
# ── 8. SAVE ──────────────────────────────────────────────────────────────────
out_path <- "/Users/valentinaparada/Dropbox/LabDropbox/Valentina/taste_proyect/dfs"
write_csv(ratings_long, file.path(out_path, "ratings_clean.csv"))
write_csv(qc_summary,   file.path(out_path, "qc_summary.csv"))
cat("\nSaved: ratings_clean.csv and qc_summary.csv\n")
library(tidyverse)
library(lme4)
library(lmerTest)
library(emmeans)
# ── 0. LOAD ───────────────────────────────────────────────────────────────────
ratings_long <- read_csv(
"~/Dropbox/LabDropbox/Valentina/taste_proyect/dfs/ratings_clean.csv",
show_col_types = FALSE
) %>%
mutate(
participant = as.factor(participant),
version     = factor(version, levels = c("original", "taste", "health")),
question    = factor(question, levels = c("liking", "taste", "health")),
product     = as.factor(product)
)
cat("Trials:       ", nrow(ratings_long), "\n")
cat("Participants: ", n_distinct(ratings_long$participant), "\n")
cat("Products:     ", n_distinct(ratings_long$product), "\n")
# ── 1. PER-PRODUCT MEANS BY VERSION × QUESTION ───────────────────────────────
# This is the key table: does the version effect go the same direction
# for every product, or does it flip / vary a lot?
product_means <- ratings_long %>%
group_by(product, version, question) %>%
summarise(
n           = n(),
mean_rating = mean(rating, na.rm = TRUE),
sd_rating   = sd(rating, na.rm = TRUE),
.groups     = "drop"
)
cat("\n── Per-product means by version and question ──────────────────\n")
print(product_means, n = 200)
# ── 2. PRODUCT-LEVEL CONGRUENT EFFECT ────────────────────────────────────────
# Question: did the HEALTH manipulation raise ratings on the HEALTH question
# (vs. original), and did the TASTE manipulation raise ratings on the TASTE
# question (vs. original)? Computed separately per manipulation to avoid
# any ambiguity from pivoting both questions together.
# -- Taste manipulation effect (on taste question only) --
taste_effect <- product_means %>%
filter(question == "taste", version %in% c("original", "taste")) %>%
select(product, version, mean_rating) %>%
pivot_wider(names_from = version, values_from = mean_rating) %>%
mutate(
manipulation = "Taste manipulation",
diff         = taste - original,
direction    = if_else(diff > 0, "expected (+)", "opposite (-)")
) %>%
rename(original_rating = original, enhanced_rating = taste) %>%
select(product, manipulation, original_rating, enhanced_rating, diff, direction)
# -- Health manipulation effect (on health question only) --
health_effect <- product_means %>%
filter(question == "health", version %in% c("original", "health")) %>%
select(product, version, mean_rating) %>%
pivot_wider(names_from = version, values_from = mean_rating) %>%
mutate(
manipulation = "Health manipulation",
diff         = health - original,
direction    = if_else(diff > 0, "expected (+)", "opposite (-)")
) %>%
rename(original_rating = original, enhanced_rating = health) %>%
select(product, manipulation, original_rating, enhanced_rating, diff, direction)
product_effects <- bind_rows(taste_effect, health_effect)
cat("\n── Per-product congruent effect (enhanced − original) ─────────\n")
print(product_effects, n = 50)
cat("\n── How many products go in the expected direction? ────────────\n")
product_effects %>%
group_by(manipulation) %>%
summarise(
n_products     = n(),
n_expected_dir = sum(direction == "expected (+)"),
prop_expected  = mean(direction == "expected (+)"),
mean_diff      = mean(diff, na.rm = TRUE),
.groups = "drop"
) %>%
print()
d_taste <- ratings_long %>%
filter(
question == "taste",
version %in% c("original", "taste")
) %>%
droplevels()
m_taste <- lmer(
rating ~ version + product + (1 | participant),
data = d_taste,
REML = FALSE
)
cat("\n\n══════════════════════════════════════════════════════════════\n")
cat("MAIN TEST 1: Taste manipulation effect on TASTE ratings\n")
cat("══════════════════════════════════════════════════════════════\n")
summary(m_taste)
cat("\nEstimated marginal means:\n")
emmeans(m_taste, ~ version)
cat("\nPairwise comparison: taste-enhanced vs original:\n")
contrast(emmeans(m_taste, ~ version), method = "pairwise")
# ── 4. MAIN MODEL 2: DOES HEALTH VERSION INCREASE HEALTH RATINGS? ─────────────
# This answers:
# Did participants who saw the health-enhanced images give higher HEALTH ratings
# than participants who saw the original images?
d_health <- ratings_long %>%
filter(
question == "health",
version %in% c("original", "health")
) %>%
droplevels()
m_health <- lmer(
rating ~ version + product + (1 | participant),
data = d_health,
REML = FALSE
)
cat("\n\n══════════════════════════════════════════════════════════════\n")
cat("MAIN TEST 2: Health manipulation effect on HEALTH ratings\n")
cat("══════════════════════════════════════════════════════════════\n")
summary(m_health)
cat("\nEstimated marginal means:\n")
emmeans(m_health, ~ version)
cat("\nPairwise comparison: health-enhanced vs original:\n")
contrast(emmeans(m_health, ~ version), method = "pairwise")
# ── 3. PRODUCT × VERSION INTERACTION MODEL ───────────────────────────────────
# If product interacts with version, the effect is heterogeneous across
# products (i.e., color-product match matters), which would explain a null
# average effect even if real effects exist for some products.
for (q in c("taste", "health")) {
cat("\n── Model with product interaction: question =", q, "──────────\n")
d <- ratings_long %>% filter(question == q)
m_interaction <- lmer(
rating ~ version * product + (1 | participant),
data = d,
REML = FALSE
)
m_no_interaction <- lmer(
rating ~ version + product + (1 | participant),
data = d,
REML = FALSE
)
cat("\nLikelihood ratio test (does version effect differ by product?):\n")
print(anova(m_no_interaction, m_interaction))
}
# ── 4. PLOT — per-product effect direction ───────────────────────────────────
p_product_effects <- product_effects %>%
mutate(product = fct_reorder(product, diff)) %>%
ggplot(aes(x = product, y = diff, fill = direction)) +
geom_col(width = 0.6) +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray40") +
facet_wrap(~ manipulation, scales = "free_x") +
scale_fill_manual(values = c("expected (+)" = "#2E7D32", "opposite (-)" = "#C62828")) +
coord_flip() +
theme_minimal(base_size = 12) +
labs(
title = "Per-product congruent effect (enhanced image − original)",
subtitle = "Green = effect in expected direction, Red = opposite",
x = "Product", y = "Rating difference (enhanced − original)"
)
print(p_product_effects)
# ── 5. PLOT — per-product means across versions ──────────────────────────────
version_colors <- c("original" = "#999999", "taste" = "#E69F00", "health" = "#56B4E9")
p_product_lines <- product_means %>%
filter(question %in% c("taste", "health")) %>%
ggplot(aes(x = version, y = mean_rating, group = product, color = product)) +
geom_line(alpha = 0.6) +
geom_point(size = 1.5) +
facet_wrap(~ question) +
theme_minimal(base_size = 12) +
labs(
title = "Per-product rating trajectories across versions",
x = "Image version", y = "Mean rating"
) +
theme(legend.position = "right")
print(p_product_lines)
m_taste_interaction <- lmer(
rating ~ version * product + (1 | participant),
data = d_taste,
REML = FALSE
)
summary(m_taste_interaction)
m_health_interaction <- lmer(
rating ~ version * product + (1 | participant),
data = d_health,
REML = FALSE
)
summary(m_health_interaction)
library(emmeans)
cat("\n── Taste manipulation effect calculated per individual product ──\n")
taste_pairs <- pairs(emmeans(m_taste_interaction, ~ version | product), reverse = TRUE)
print(taste_pairs)
cat("\n── Health manipulation effect calculated per individual product ──\n")
health_pairs <- pairs(emmeans(m_health_interaction, ~ version | product), reverse = TRUE)
print(health_pairs)
# ── MAIN RESULTS TABLE FOR PROFESSOR ─────────────────────────
taste_emm <- emmeans(m_taste, ~ version)
health_emm <- emmeans(m_health, ~ version)
taste_table <- as.data.frame(taste_emm)
health_table <- as.data.frame(health_emm)
taste_contrast <- as.data.frame(
contrast(taste_emm, method = "revpairwise")
)
health_contrast <- as.data.frame(
contrast(health_emm, method = "revpairwise")
)
main_results_table <- tibble(
test = c(
"Taste-enhanced effect on taste ratings",
"Health-enhanced effect on health ratings"
),
original_mean = c(
taste_table$emmean[taste_table$version == "original"],
health_table$emmean[health_table$version == "original"]
),
enhanced_mean = c(
taste_table$emmean[taste_table$version == "taste"],
health_table$emmean[health_table$version == "health"]
),
enhanced_minus_original = c(
taste_contrast$estimate,
health_contrast$estimate
),
SE = c(
taste_contrast$SE,
health_contrast$SE
),
df = c(
taste_contrast$df,
health_contrast$df
),
p_value = c(
taste_contrast$p.value,
health_contrast$p.value
)
) %>%
mutate(
conclusion = if_else(p_value < .05, "Significant", "Not significant"),
across(
c(original_mean, enhanced_mean, enhanced_minus_original, SE, df, p_value),
~ round(.x, 3)
)
)
print(main_results_table)
library(tidyverse)
library(lme4)
library(lmerTest)   # gives p-values for lmer
library(emmeans)    # for pairwise comparisons
# ── 0. LOAD ───────────────────────────────────────────────────────────────────
ratings_long <- read_csv(
"~/Dropbox/LabDropbox/Valentina/taste_proyect/dfs/ratings_clean.csv",
show_col_types = FALSE
) %>%
mutate(
participant = as.factor(participant),
version     = factor(version, levels = c("original", "taste", "health")),
question    = factor(question, levels = c("liking", "taste", "health")),
product     = as.factor(product)
)
cat("Trials:       ", nrow(ratings_long), "\n")
cat("Participants: ", n_distinct(ratings_long$participant), "\n")
cat("Per condition:\n")
print(table(ratings_long$version))
# ── 1. DESCRIPTIVES ───────────────────────────────────────────────────────────
mean_table <- ratings_long %>%
group_by(version, question) %>%
summarise(
n           = n(),
mean_rating = mean(rating, na.rm = TRUE),
sd_rating   = sd(rating, na.rm = TRUE),
se_rating   = sd_rating / sqrt(n),
.groups     = "drop"
) %>%
arrange(question, version)
cat("\n── Mean ratings by version and question ─────────────────────\n")
print(mean_table)
# ── 2. MIXED MODELS ───────────────────────────────────────────────────────────
# version is between-subjects (each participant saw only one)
# question is within-subjects (each participant answered all 3)
# random effects: by-participant intercept, by-product intercept
# 2a. Aim 1A — congruent questions only (taste & health)
ratings_aim1a <- ratings_long %>%
filter(question %in% c("taste", "health"))
model_aim1a <- lmer(
rating ~ version * question + (1 | participant) + (1 | product),
data = ratings_aim1a,
REML = FALSE
)
cat("\n── Aim 1A model (version × question, taste & health only) ────\n")
print(summary(model_aim1a))
print(anova(model_aim1a))
# 2b. Separate model per question
liking_model <- lmer(
rating ~ version + (1 | participant) + (1 | product),
data = ratings_long %>% filter(question == "liking"),
REML = FALSE
)
taste_model <- lmer(
rating ~ version + (1 | participant) + (1 | product),
data = ratings_long %>% filter(question == "taste"),
REML = FALSE
)
health_model <- lmer(
rating ~ version + (1 | participant) + (1 | product),
data = ratings_long %>% filter(question == "health"),
REML = FALSE
)
cat("\n── Model: question = liking ───────────────────────────────────\n")
print(summary(liking_model))
print(anova(liking_model))
cat("\nPairwise comparisons:\n")
print(pairs(emmeans(liking_model, ~ version), adjust = "bonferroni"))
cat("\n── Model: question = taste ─────────────────────────────────────\n")
print(summary(taste_model))
print(anova(taste_model))
cat("\nPairwise comparisons:\n")
print(pairs(emmeans(taste_model, ~ version), adjust = "bonferroni"))
cat("\n── Model: question = health ────────────────────────────────────\n")
print(summary(health_model))
print(anova(health_model))
cat("\nPairwise comparisons:\n")
print(pairs(emmeans(health_model, ~ version), adjust = "bonferroni"))
# ── 3. PLOTS ──────────────────────────────────────────────────────────────────
version_colors  <- c("original" = "#999999", "taste" = "#E69F00", "health" = "#56B4E9")
question_labels <- c("liking" = "Liking", "taste" = "Taste", "health" = "Health")
# Plot 1 — Mean ratings by version and question
p1 <- mean_table %>%
ggplot(aes(x = version, y = mean_rating, fill = version)) +
geom_col(width = 0.55, alpha = 0.85) +
geom_errorbar(aes(ymin = mean_rating - se_rating,
ymax = mean_rating + se_rating),
width = 0.2, linewidth = 0.7) +
facet_wrap(~ question, labeller = labeller(question = question_labels)) +
scale_fill_manual(values = version_colors) +
scale_y_continuous(limits = c(0, 7), breaks = 0:7) +
theme_minimal(base_size = 13) +
labs(
title = "Mean ratings by image version and question",
subtitle = "Error bars = SE",
x = "Image version", y = "Mean rating (0–7)"
) +
theme(legend.position = "none")
print(p1)
# Plot 2 — Boxplot with jitter
p2 <- ratings_long %>%
ggplot(aes(x = version, y = rating, fill = version)) +
geom_boxplot(alpha = 0.65, outlier.shape = NA, width = 0.5) +
geom_jitter(width = 0.12, alpha = 0.18, size = 0.7) +
facet_wrap(~ question, labeller = labeller(question = question_labels)) +
scale_fill_manual(values = version_colors) +
scale_y_continuous(limits = c(0, 7), breaks = 0:7) +
theme_minimal(base_size = 13) +
labs(
title = "Rating distributions by image version and question",
x = "Image version", y = "Rating (0–7)"
) +
theme(legend.position = "none")
print(p2)
# Plot 3 — Participant-level means (to see variability between subjects)
participant_means <- ratings_long %>%
group_by(participant, version, question) %>%
summarise(mean_rating = mean(rating, na.rm = TRUE), .groups = "drop")
p3 <- participant_means %>%
ggplot(aes(x = version, y = mean_rating, color = version)) +
geom_point(alpha = 0.6, size = 2, position = position_jitter(width = 0.1)) +
stat_summary(fun = mean, geom = "crossbar", width = 0.4,
color = "black", linewidth = 0.6) +
facet_wrap(~ question, labeller = labeller(question = question_labels)) +
scale_color_manual(values = version_colors) +
scale_y_continuous(limits = c(0, 7), breaks = 0:7) +
theme_minimal(base_size = 13) +
labs(
title = "Participant-level mean ratings by version and question",
subtitle = "Black bar = group mean",
x = "Image version", y = "Mean rating (0–7)"
) +
theme(legend.position = "none")
print(p3)
View(product_means)
View(main_results_table)
library(tidyverse)
# ── 0. PATHS ─────────────────────────────────────────────────────────────────
base_path <- "~/Dropbox/LabDropbox/Valentina/taste_proyect/results1/resultjune"
conditions <- c("original", "taste", "health")
# ── 1. LOAD — one folder per condition ───────────────────────────────────────
raw_data <- map_df(conditions, function(cond) {
folder <- file.path(base_path, cond)
files  <- list.files(path = folder, pattern = "*.csv", full.names = TRUE)
if (length(files) == 0) {
warning("No CSVs found in: ", folder)
return(NULL)
}
map_df(files, ~ read_csv(.x, show_col_types = FALSE)) %>%
mutate(condition = cond)   # tag with condition in case block_image_version is missing
})
cat("Raw rows loaded:", nrow(raw_data), "\n")
cat("Participants:   ", n_distinct(raw_data$PROLIFIC_PID), "\n")
cat("Condition counts:\n")
print(table(raw_data$condition))
# ── 2. RATINGS — clean long format ───────────────────────────────────────────
ratings_all <- raw_data %>%
mutate(participant = as.factor(PROLIFIC_PID)) %>%
filter(!is.na(product_id) & product_id != "") %>%
mutate(
version  = factor(condition, levels = c("original", "taste", "health")),
product  = product_id,
question = block_question,
rating = case_when(
block_question == "liking" ~ as.numeric(rating_liking),
block_question == "taste"  ~ as.numeric(rating_taste),
block_question == "health" ~ as.numeric(rating_health),
TRUE ~ NA_real_
),
rt = case_when(
block_question == "liking" ~ as.numeric(rt_liking),
block_question == "taste"  ~ as.numeric(rt_taste),
block_question == "health" ~ as.numeric(rt_health),
TRUE ~ NA_real_
),
trial_n   = as.integer(main_loop.thisN),
block_num = as.integer(block_num)
)
cat("\nRating trials:  ", nrow(ratings_all), "\n")
cat("Participants:   ", n_distinct(ratings_all$participant), "\n")
cat("Products:       ", n_distinct(ratings_all$product), "\n")
cat("Versions:\n", n_distinct(ratings_all$block_image_version), "\n")
print(table(ratings_all$version))
# ── 3. QC — missing ratings ───────────────────────────────────────────────────
participant_missing <- ratings_all %>%
group_by(participant, version) %>%
summarise(
total_trials   = n(),
missing_ratings = sum(is.na(rating)),
prop_missing   = mean(is.na(rating)),
.groups = "drop"
)
cat("\nMissing ratings per participant (top 10):\n")
print(participant_missing %>% arrange(desc(prop_missing)) %>% head(10))
# ── 4. QC — memory accuracy ──────────────────────────────────────────────────
memory_data <- ratings_all %>%
filter(as.numeric(memory_catch_shown) == 1) %>%
mutate(
correct = as.numeric(memory_correct),
rt_mem  = as.numeric(memory_rt)
)
memory_by_participant <- memory_data %>%
group_by(participant, version) %>%
summarise(
memory_accuracy  = mean(correct, na.rm = TRUE),
mean_memory_rt   = mean(rt_mem[correct == 1], na.rm = TRUE),
n_memory_trials  = n(),
.groups = "drop"
)
cat("\nMemory accuracy per participant:\n")
print(memory_by_participant)
# ── 5. QC — response variability & repeated answers ──────────────────────────
df_movement <- ratings_all %>%
mutate(
rating_current = case_when(
block_question == "liking" ~ as.numeric(rating_liking),
block_question == "taste"  ~ as.numeric(rating_taste),
block_question == "health" ~ as.numeric(rating_health),
TRUE ~ NA_real_
)
) %>%
group_by(participant, block_num) %>%
mutate(
previous_rating           = lag(rating_current),
movement_from_previous    = abs(rating_current - previous_rating),
same_as_previous          = movement_from_previous < 0.1
) %>%
ungroup()
movement_by_participant <- df_movement %>%
group_by(participant, version) %>%
summarise(
n_comparisons          = sum(!is.na(movement_from_previous)),
mean_movement          = mean(movement_from_previous, na.rm = TRUE),
median_movement        = median(movement_from_previous, na.rm = TRUE),
prop_same_as_previous  = mean(same_as_previous, na.rm = TRUE),
sd_all_ratings         = sd(rating_current, na.rm = TRUE),
.groups = "drop"
)
# ── 6. FINAL QC SUMMARY ──────────────────────────────────────────────────────
qc_summary <- participant_missing %>%
left_join(memory_by_participant,  by = c("participant", "version")) %>%
left_join(movement_by_participant, by = c("participant", "version")) %>%
mutate(
memory_accuracy = if_else(is.na(memory_accuracy), 0, memory_accuracy),
exclude_missing          = prop_missing > 0.25,
exclude_memory           = memory_accuracy < 0.60,
exclude_repeated_answers = prop_same_as_previous > 0.50,
exclude_low_sd           = sd_all_ratings < 0.50,
exclude_final = exclude_missing | exclude_memory |
exclude_repeated_answers | exclude_low_sd
)
cat("\n── QC Summary ──────────────────────────────────────────────\n")
print(qc_summary)
cat("\n── Exclusion counts by reason ──────────────────────────────\n")
qc_summary %>%
summarise(
missing          = sum(exclude_missing),
memory           = sum(exclude_memory),
repeated_answers = sum(exclude_repeated_answers),
low_sd           = sum(exclude_low_sd),
total_excluded   = sum(exclude_final)
) %>%
print()
View(qc_summary)
